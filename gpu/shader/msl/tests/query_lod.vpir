module fragment

input uv : vec3<f32> location(0)
input dir : vec4<f32> location(1)
output color : vec4<f32> location(0)
texture layers : 2d_array f32 index(0)
texture cubes : cube_array f32 index(1)
sampler smp : index(2)

; Lod queries (GCN image_get_lod): Metal takes the coordinate without the array layer.
func main() {
  %0 = load_input uv : vec3<f32>
  %1 = load_input dir : vec4<f32>
  %2 = image_query_lod layers, smp, %0 : vec2<f32>
  %3 = image_query_lod cubes, smp, %1 : vec2<f32>
  %4 = add %2, %3 : vec2<f32>
  %5 = extract %4, 0 : f32
  %6 = extract %4, 1 : f32
  %7 = const 1.0 : f32
  %8 = construct %5, %6, %7, %7 : vec4<f32>
  store_output color, %8
}
