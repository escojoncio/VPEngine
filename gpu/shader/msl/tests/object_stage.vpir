module object
workgroup_size 1 1 1
payload_bytes 16

input group : vec3<u32> builtin(workgroup_id)
constant_buffer params : index(0)

; Amplifies one quad per group: the payload carries its corner and size to the mesh stage.
func main() {
  %0 = load_input group : vec3<u32>
  %1 = extract %0, 0 : u32
  %2 = const 0 : u32
  %3 = load params, %2 : vec4<f32>
  %4 = convert %1 : f32
  %5 = extract %3, 0 : f32
  %6 = mul %4, %5 : f32
  %7 = bitcast %6 : u32
  store payload, %2, %7
  %8 = const 4 : u32
  %9 = extract %3, 1 : f32
  %10 = bitcast %9 : u32
  store payload, %8, %10
  %11 = const 1 : u32
  mesh_dispatch %11, %11, %11
}
