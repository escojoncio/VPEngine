module fragment
private_slot 32
private_slot 32
private_slot 16
private_slot 16

input a : vec4<f32> location(0)
output color : vec4<f32> location(0)

; Per-variable private slots. Slot 0 is only touched at constant offsets (a whole vec4, one of its
; components, a second cell): it becomes typed locals. Slot 1 is indexed dynamically and slot 2 is
; read back as another type: both keep the byte-addressed array. Slot 3 is never used: no storage.
func main() {
  %0 = load_input a : vec4<f32>
  %1 = const 0 : u32
  %2 = const 12 : u32
  %3 = const 16 : u32
  store private_0, %1, %0
  %4 = extract %0, 1 : f32
  store private_0, %2, %4
  store private_0, %3, %4
  %5 = load private_0, %1 : vec4<f32>
  %6 = load private_0, %3 : f32
  %7 = bitcast %4 : u32
  %8 = const 1 : u32
  %9 = and %7, %8 : u32
  %10 = mul %9, %3 : u32
  store private_1, %10, %0
  %11 = load private_1, %1 : vec4<f32>
  store private_2, %1, %4
  %12 = load private_2, %1 : u32
  %13 = convert %12 : f32
  %14 = add %5, %11 : vec4<f32>
  %15 = add %6, %13 : f32
  %16 = insert %14, %15, 0 : vec4<f32>
  store_output color, %16
}
