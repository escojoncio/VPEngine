module fragment

input uv : vec2<f32> location(0)
input tint : vec4<f32> location(1) linear centroid
output color : vec4<f32> location(0)
constant_buffer params : index(0)
texture albedo : 2d f32 index(0)
sampler smp : index(0)

func main() {
  %0 = load_input uv : vec2<f32>
  %1 = image_sample albedo, smp, %0 : vec4<f32>
  %2 = extract %1, 3 : f32
  %3 = const 0 : u32
  %4 = load params, %3 : f32
  %5 = lt %2, %4 : bool
  if %5 {
    discard
  }
  %6 = load_input tint : vec4<f32>
  %7 = mul %1, %6 : vec4<f32>
  store_output color, %7
}
