module fragment

input frag_pos : vec4<f32> builtin(position)
input uv : vec2<f32> location(0)
output color : vec4<f32> location(0)
texture gbuf : 2d f32 index(0)
sampler linear : index(0)

; fetch-map: 0=0
; reject: not known to filter nearest
; reject: not this fragment's pixel centre
func main() {
  %0 = load_input frag_pos : vec4<f32>
  %1 = shuffle %0, %0, 0, 1 : vec2<f32>
  %2 = image_size gbuf : vec2<u32>
  %3 = convert %2 : vec2<f32>
  %4 = div %1, %3 : vec2<f32>
  %5 = image_sample gbuf, linear, %4 : vec4<f32>
  %6 = load_input uv : vec2<f32>
  %7 = image_sample gbuf, linear, %6 : vec4<f32>
  %8 = add %5, %7 : vec4<f32>
  store_output color, %8
}
