module compute
workgroup_size 32 1 1

input gid : vec3<u32> builtin(global_invocation_id)
input lane : u32 builtin(subgroup_invocation)
buffer out : index(0) write
buffer src : index(1) read

func main() {
  %0 = load_input gid : vec3<u32>
  %1 = extract %0, 0 : u32
  %2 = load_input lane : u32
  %3 = const 2 : u32
  %4 = shl %1, %3 : u32
  %5 = load src, %4 : f32
  %6 = const 0.0 : f32
  %7 = gt %5, %6 : bool
  %8 = subgroup_ballot %7 : vec4<u32>
  %9 = subgroup_any %7 : bool
  %10 = subgroup_all %7 : bool
  %11 = subgroup_read_first %5 : f32
  %12 = const 1 : u32
  %13 = xor %2, %12 : u32
  %14 = subgroup_shuffle %5, %13 : f32
  %15 = subgroup_broadcast %5, %12 : f32
  %16 = select %9, %11, %14 : f32
  %17 = select %10, %15, %16 : f32
  %18 = const 4 : u32
  %19 = shl %1, %18 : u32
  store out, %19, %8
  %20 = const 16 : u32
  %21 = add %19, %20 : u32
  store out, %21, %17
}
