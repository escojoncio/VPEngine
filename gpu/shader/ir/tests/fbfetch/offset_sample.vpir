module fragment

input frag_pos : vec4<f32> builtin(position)
output color : vec4<f32> location(0)
texture gbuf : 2d f32 index(0)
sampler point : index(0)

; VPIR's image_fetch takes no offset, so a neighbour read by offset is a sample.
; fetch-map: 0=0
; nearest: 0
; reject: texel offset
func main() {
  %0 = load_input frag_pos : vec4<f32>
  %1 = shuffle %0, %0, 0, 1 : vec2<f32>
  %2 = image_size gbuf : vec2<u32>
  %3 = convert %2 : vec2<f32>
  %4 = div %1, %3 : vec2<f32>
  %5 = const 0.0 : f32
  %6 = const 1, 0 : vec2<i32>
  %7 = image_sample gbuf, point, %4, lod(%5), offset(%6) : vec4<f32>
  store_output color, %7
}
